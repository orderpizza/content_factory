{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content_factory/render_manifest_v1",
  "type": "object", "additionalProperties": false,
  "required": ["content_identity", "content_hash", "renderer", "assets"],
  "properties": {
    "content_identity": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["provider", "version"], "properties": {"provider": {"type": "string"}, "version": {"type": "string"}}},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "ordinal", "mime_type", "width_px", "height_px", "bytes", "sha256"], "properties": {"role": {"enum": ["preview_html", "preview_png", "delivery_jpeg"]}, "ordinal": {"type": "integer", "minimum": 1}, "mime_type": {"type": "string"}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  },
  "x-owner": "docs/specs/visual-rendering.md"
}
