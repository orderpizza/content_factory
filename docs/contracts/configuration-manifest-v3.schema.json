{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content_factory/configuration_manifest_v3",
  "title": "Detection dashboard configuration release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_name",
    "scope_key",
    "schema_id",
    "schema_version",
    "created_at",
    "components"
  ],
  "properties": {
    "release_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "scope_key": {
      "const": "global"
    },
    "schema_id": {
      "const": "configuration_manifest_v3"
    },
    "schema_version": {
      "const": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection"
      ],
      "properties": {
        "detection": {
          "$ref": "#/$defs/detection"
        }
      }
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_version",
        "score_formula_version",
        "shortlist",
        "sources",
        "cluster_aliases"
      ],
      "properties": {
        "canonicalization_version": {
          "const": "canonicalization_v2"
        },
        "score_formula_version": {
          "const": "attention_v2"
        },
        "shortlist": {
          "$ref": "#/$defs/shortlist"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "cluster_aliases": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/cluster_alias"
          }
        }
      }
    },
    "shortlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "minimum_score",
        "minimum_reliability",
        "max_selected_6h",
        "max_selected_24h",
        "deferred_fresh_hours",
        "cooldown_days",
        "material_score_delta"
      ],
      "properties": {
        "policy_version": {
          "const": "shortlist_v1"
        },
        "minimum_score": {
          "const": 0.6
        },
        "minimum_reliability": {
          "const": 0.7
        },
        "max_selected_6h": {
          "const": 2
        },
        "max_selected_24h": {
          "const": 6
        },
        "deferred_fresh_hours": {
          "const": 48
        },
        "cooldown_days": {
          "const": 3
        },
        "material_score_delta": {
          "const": 0.15
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "source_kind",
        "adapter_version",
        "provider_name",
        "endpoint_url",
        "coverage_note",
        "enabled",
        "cadence_seconds",
        "availability_seconds",
        "trust_weight",
        "independence_group",
        "options"
      ],
      "properties": {
        "stable_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{0,99}$"
        },
        "source_kind": {
          "enum": [
            "publisher_feed_collector_v1",
            "wikimedia_enwiki_pageviews_v1",
            "youtube_most_popular_v1",
            "hacker_news_top_stories_v1"
          ]
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "endpoint_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "delivery_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rss",
            "atom",
            "json",
            null
          ]
        },
        "coverage_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "availability_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 172800
        },
        "trust_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "independence_group": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
        },
        "language_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "region_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "quota_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "secret_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
        },
        "allowed_redirect_hosts": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "project": {
              "type": "string",
              "maxLength": 100
            },
            "access": {
              "type": "string",
              "maxLength": 50
            },
            "agent": {
              "type": "string",
              "maxLength": 50
            },
            "region_code": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "parts": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 50
              }
            }
          }
        }
      }
    },
    "cluster_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_key",
        "target_cluster_key",
        "active",
        "reason"
      ],
      "properties": {
        "alias_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "target_cluster_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "active": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  },
  "x-owner": "docs/specs/configuration.md"
}
