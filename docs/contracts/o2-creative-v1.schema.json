{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-maturity": "superseded",
  "x-replacement-owner": "docs/pipelines/domains.md",
  "$comment": "Retained unimplemented draft. Do not use for Phase 1 production; author a new version under the replacement owner before activation.",
  "$id": "content_factory/o2_creative_v1",
  "type": "object", "additionalProperties": false,
  "required": ["word", "part_of_speech", "sense", "slides", "claims"],
  "properties": {
    "word": {"type": "string", "pattern": "^[A-Za-z][A-Za-z '-]{0,59}$"},
    "part_of_speech": {"type": "string", "minLength": 1, "maxLength": 60},
    "sense": {"type": "string", "minLength": 1, "maxLength": 300},
    "slides": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["role", "text", "claim_ids"], "properties": {"role": {"enum": ["hook", "explanation", "use_case", "cta"]}, "text": {"type": "string", "minLength": 1, "maxLength": 1200}, "claim_ids": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"}}}}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text", "assertion_id"], "properties": {"claim_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"}, "text": {"type": "string", "minLength": 1, "maxLength": 800}, "assertion_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"}}}}
  },
  "x-owner": "docs/pipelines/o2-english-instagram.md"
}
