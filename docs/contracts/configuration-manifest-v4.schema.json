{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content_factory/configuration_manifest_v4",
  "title": "Detection semantic event configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_name",
    "scope_key",
    "schema_id",
    "schema_version",
    "created_at",
    "components"
  ],
  "properties": {
    "release_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "scope_key": {
      "const": "global"
    },
    "schema_id": {
      "const": "configuration_manifest_v4"
    },
    "schema_version": {
      "const": 4
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection"
      ],
      "properties": {
        "detection": {
          "$ref": "#/$defs/detection"
        }
      }
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_version",
        "score_formula_version",
        "shortlist",
        "sources",
        "semantic_resolution"
      ],
      "properties": {
        "canonicalization_version": {
          "const": "canonicalization_v2"
        },
        "score_formula_version": {
          "const": "attention_v3"
        },
        "shortlist": {
          "$ref": "#/$defs/shortlist"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "semantic_resolution": {
          "$ref": "#/$defs/semantic_resolution"
        }
      }
    },
    "shortlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "minimum_score",
        "minimum_reliability",
        "max_selected_6h",
        "max_selected_24h",
        "deferred_fresh_hours",
        "cooldown_days",
        "material_score_delta"
      ],
      "properties": {
        "policy_version": {
          "const": "shortlist_v2"
        },
        "minimum_score": {
          "const": 0.6
        },
        "minimum_reliability": {
          "const": 0.7
        },
        "max_selected_6h": {
          "const": 2
        },
        "max_selected_24h": {
          "const": 6
        },
        "deferred_fresh_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cooldown_days": {
          "const": 3
        },
        "material_score_delta": {
          "const": 0.15
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "source_kind",
        "adapter_version",
        "provider_name",
        "endpoint_url",
        "coverage_note",
        "enabled",
        "cadence_seconds",
        "availability_seconds",
        "trust_weight",
        "independence_group",
        "options"
      ],
      "properties": {
        "stable_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{0,99}$"
        },
        "source_kind": {
          "enum": [
            "publisher_feed_collector_v1",
            "wikimedia_enwiki_pageviews_v1",
            "hacker_news_top_stories_v1"
          ]
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "endpoint_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "delivery_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rss",
            "atom",
            "json",
            null
          ]
        },
        "coverage_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "enabled": {
          "type": "boolean"
        },
        "cadence_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "availability_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 172800
        },
        "trust_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "independence_group": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
        },
        "language_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "region_scope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "quota_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "secret_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
        },
        "allowed_redirect_hosts": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "project": {
              "type": "string",
              "maxLength": 100
            },
            "access": {
              "type": "string",
              "maxLength": 50
            },
            "agent": {
              "type": "string",
              "maxLength": 50
            },
            "region_code": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "parts": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 50
              }
            }
          }
        }
      }
    },
    "semantic_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "dimensions",
        "cpu_threads",
        "batch_size",
        "recent_hours",
        "max_pair_hours",
        "max_clusters",
        "max_pairs",
        "max_neighbors",
        "max_group_size",
        "similarity_decimals",
        "link_threshold",
        "separate_threshold",
        "entity_aliases",
        "entity_stopwords",
        "negation_terms",
        "event_terms"
      ],
      "properties": {
        "model_id": {
          "const": "sentence-transformers/all-MiniLM-L6-v2"
        },
        "model_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dimensions": {
          "const": 384
        },
        "cpu_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "recent_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "max_pair_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        },
        "max_clusters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "max_neighbors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_group_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "similarity_decimals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "link_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "separate_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entity_aliases": {
          "type": "object",
          "maxProperties": 500,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity_stopwords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 500
        },
        "negation_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 500
        },
        "event_terms": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": "Runtime validation additionally enforces lowercase and cross-category vocabulary uniqueness, separate_threshold < link_threshold and max_pair_hours <= recent_hours."
    }
  },
  "x-owner": "docs/specs/configuration.md"
}
