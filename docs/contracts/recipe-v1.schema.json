{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-maturity": "superseded",
  "x-replacement-owner": "docs/specs/content-production.md",
  "$comment": "Retained unimplemented draft. Do not use for Phase 1 production; author a new version under the replacement owner before activation.",
  "$id": "content_factory/recipe_v1",
  "type": "object", "additionalProperties": false,
  "required": ["pipeline_id", "platform_id", "account_id", "format_id", "topic", "angle", "audience", "objective", "key_points", "visual_profile_policy"],
  "properties": {
    "pipeline_id": {"type": "string", "pattern": "^[a-z0-9_/-]{1,100}$"},
    "platform_id": {"type": "string", "pattern": "^[a-z0-9_-]{1,100}$"},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "format_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "topic": {"type": "string", "minLength": 1, "maxLength": 500},
    "angle": {"type": "string", "minLength": 1, "maxLength": 1000},
    "audience": {"type": "string", "minLength": 1, "maxLength": 500},
    "objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "key_points": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "visual_profile_policy": {"type": "object", "additionalProperties": false, "required": ["allowed_profile_ids"], "properties": {"allowed_profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}}}
  },
  "x-owner": "docs/specs/idea-intake-and-determination.md"
}
