<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.contentfactory.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/content_factory/.venv/bin/python</string>
        <string>/Users/YOUR_USERNAME/content_factory/scripts/run_collector.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/content_factory</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>src</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/content_factory/data/collector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/content_factory/data/collector.error.log</string>
</dict>
</plist>
