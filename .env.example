# Copy to .env for local development. Never commit .env.
#
# Secrets remain local. Non-secret values below are setup inputs: the explicit
# production configuration command validates and freezes them into SQLite.
# Editing this file never activates an account or authorizes a post.

# Vertex AI connection. Authenticate locally with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Required by --production. Copy current prices for the configured model from
# the provider's official pricing page and choose finite owner budgets.
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=
GEMINI_DAILY_WARNING_USD=
GEMINI_DAILY_HARD_LIMIT_USD=
GEMINI_JOB_HARD_LIMIT_USD=
# Optional bounded phase overrides (defaults are documented in configuration.md).
# GEMINI_INTAKE_MAX_INPUT_TOKENS=8000
# GEMINI_INTAKE_MAX_OUTPUT_TOKENS=2000
# GEMINI_DETERMINATION_MAX_INPUT_TOKENS=12000
# GEMINI_DETERMINATION_MAX_OUTPUT_TOKENS=4000
# GEMINI_GENERATION_MAX_INPUT_TOKENS=12000
# GEMINI_GENERATION_MAX_OUTPUT_TOKENS=4000
# GEMINI_ADAPTATION_MAX_INPUT_TOKENS=12000
# GEMINI_ADAPTATION_MAX_OUTPUT_TOKENS=4000

# Local process composition. Dashboard must remain loopback-only in the POC.
CONTENT_FACTORY_DB_PATH=data/content.db
CONTENT_FACTORY_ARTIFACT_ROOT=data/artifacts
CONTENT_FACTORY_BACKUP_ROOT=data/backups
# --production embeds and fingerprints this reviewed local font in every render.
CONTENT_FACTORY_FONT_PATH=/System/Library/Fonts/Supplemental/Arial.ttf
# Optional independent expected hash; configure_production always records the
# computed SHA-256 and refuses this value when it differs.
CONTENT_FACTORY_FONT_SHA256=
CONTENT_FACTORY_DASHBOARD_HOST=127.0.0.1
CONTENT_FACTORY_DASHBOARD_PORT=8787

# Credentials whose use is enabled only by the active configuration release.
YOUTUBE_API_KEY=

# Instagram token for the configured O2 destination. The account ID, Graph API
# version, bucket, endpoint, and public domain are non-secret release settings.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_KEY=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v24.0

# Cloudflare R2 S3 credentials for the configured transient-media store.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# OAuth 2.0 user-context access token for the configured X account.
X_USER_ACCESS_TOKEN=
X_ACCOUNT_KEY=
X_USER_ID=
