# Copy to .env for local development. Never commit .env.
#
# This file contains only local secrets and process-composition roots. Source
# selection, scores, model choice/budgets, capabilities, profile definitions,
# publishing policy, account/destination IDs, and public-media domain/bucket
# settings belong to an activated configuration release, never this file.
# That is the target policy: current v1 releases support detection only.
# V2 is an offline placeholder demo. See docs/current-state.md for actual
# consumers and separate legacy names; this is not a legacy publishing template.

# Vertex AI connection. Authenticate locally with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Local process composition. Dashboard must remain loopback-only in the POC.
CONTENT_FACTORY_DB_PATH=data/content.db
CONTENT_FACTORY_ARTIFACT_ROOT=data/artifacts
# Reserved for the future backup worker; currently unused.
CONTENT_FACTORY_BACKUP_ROOT=
CONTENT_FACTORY_DASHBOARD_HOST=127.0.0.1
CONTENT_FACTORY_DASHBOARD_PORT=8787

# Credentials whose use is enabled only by the active configuration release.
YOUTUBE_API_KEY=

# Instagram token for the configured O2 destination. The account ID, Graph API
# version, bucket, endpoint, and public domain are non-secret release settings.
INSTAGRAM_ACCESS_TOKEN=

# Cloudflare R2 S3 credentials for the configured transient-media store.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
