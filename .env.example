# Copy to .env for local development. Never commit .env.

# Gemini / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
# Optional current per-million-token USD rates for local cost estimates.
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=

# Local database
CONTENT_FACTORY_DB_PATH=data/content.db
CONTENT_FACTORY_TOP_N_CANDIDATES=5
CONTENT_FACTORY_MINIMUM_TREND_SCORE=0.25
CONTENT_FACTORY_RETENTION_DAYS=90
CONTENT_FACTORY_ARCHIVE_DIR=data/archive

# Comma-separated RSS/Atom feed URLs. Leave empty to use API sources only.
CONTENT_FACTORY_RSS_FEEDS=
# Example broad feeds:
# https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.npr.org/1001/rss.xml

# Optional Reddit source. Keep empty to disable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=all,news,technology

# Optional YouTube source. Keep empty to disable.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# Google Trends remains intentionally disabled until alpha access is granted.
GOOGLE_TRENDS_ENABLED=false

# Free POC publishing target: Bluesky
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Instagram carousel publishing (configured only when the o2_english post path is enabled)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v24.0
# Public media required by the Instagram Graph API; Cloudflare R2 is one supported store.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
