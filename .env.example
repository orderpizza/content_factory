# Copy to .env for local development. Never commit .env.
# Canonical tracked inventory of operator-facing settings.

# Vertex AI connection. Authenticate locally with Application Default Credentials.
# For gemini-3-flash-preview, use GOOGLE_CLOUD_LOCATION=global.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Required by every --gemini runner mode. Copy current prices for the configured model from
# the provider's official pricing page and choose finite owner budgets.
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=
GEMINI_DAILY_WARNING_USD=
GEMINI_DAILY_HARD_LIMIT_USD=
# Per ContentJob: generation, adaptations and image rendering (e.g. 0.50 USD).
# Intake/Determination count toward the daily cap, before a ContentJob exists.
GEMINI_JOB_HARD_LIMIT_USD=
# Opt-in live acceptance controls only; these do not enable production workers.
# A live acceptance run also requires the --live-gemini CLI flag.
CONTENT_FACTORY_ENABLE_LIVE_GEMINI_TESTS=
# Set a finite positive USD ceiling before an explicitly opted-in live run.
LIVE_TEST_MAX_USD=
LIVE_TEST_MAX_CALLS=
LIVE_TEST_MAX_IMAGE_CALLS=
LIVE_TEST_MAX_CASES=
# Supported Instagram review carousels make one storyboard image-model call.
# The response is a 5:4 image split locally into a 3×2 set of final slides.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Gemini 3.1 Flash Image supports 1K, 2K, and 4K. Storyboard review uses 2K.
GEMINI_IMAGE_SIZE=2K
GEMINI_IMAGE_INPUT_COST_PER_MILLION_USD=
GEMINI_IMAGE_OUTPUT_COST_PER_MILLION_USD=
# GEMINI_IMAGE_RENDERING_MAX_INPUT_TOKENS=8000
# GEMINI_IMAGE_RENDERING_MAX_OUTPUT_TOKENS=8000
# Optional bounded phase overrides (defaults are documented in configuration.md).
# GEMINI_INTAKE_MAX_INPUT_TOKENS=8000
# GEMINI_INTAKE_MAX_OUTPUT_TOKENS=2000
# GEMINI_DETERMINATION_MAX_INPUT_TOKENS=12000
# GEMINI_DETERMINATION_MAX_OUTPUT_TOKENS=4000
# GEMINI_EDITORIAL_PLANNING_MAX_INPUT_TOKENS=12000
# GEMINI_EDITORIAL_PLANNING_MAX_OUTPUT_TOKENS=4000
# GEMINI_GENERATION_MAX_INPUT_TOKENS=12000
# GEMINI_GENERATION_MAX_OUTPUT_TOKENS=6000
# GEMINI_ADAPTATION_MAX_INPUT_TOKENS=12000
# Carousel JSON and thinking share this output allowance.
# GEMINI_ADAPTATION_MAX_OUTPUT_TOKENS=8000

# Local process composition. Dashboard must remain loopback-only in the POC.
CONTENT_FACTORY_DB_PATH=data/development.db
CONTENT_FACTORY_ARTIFACT_ROOT=data/artifacts
CONTENT_FACTORY_BACKUP_ROOT=data/backups
# Safe JSON diagnostics only. Rotation per process; seven-day startup retention.
CONTENT_FACTORY_LOG_ROOT=data/logs
CONTENT_FACTORY_LOG_MAX_BYTES=2000000
CONTENT_FACTORY_LOG_BACKUPS=3
# Optional local font for the accepted transparent Gemini overlays.
CONTENT_FACTORY_FONT_PATH=/System/Library/Fonts/Supplemental/Arial.ttf
CONTENT_FACTORY_DASHBOARD_HOST=127.0.0.1
CONTENT_FACTORY_DASHBOARD_PORT=8787

# Preserved inactive R2 relay only; not used by planning or review workers.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
